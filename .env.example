# Configuration for every service in this repo.
#
#   cp .env.example .env      then fill in the REQUIRED values below.
#
# Each service reads .env itself when it starts (no `source` needed), from the
# directory you start it in (run commands from the repo root). Real environment
# variables override the file. QUILR_ENV_FILE=path/to/file uses a different file.
#
# Each service reads only its own variables. A misspelled name with a service's
# prefix (e.g. LLM_GATEWAY_PROT) stops that service with an error naming it,
# and so does a missing or invalid required value.
#
# .env is git-ignored: never commit it. The values in this file are fakes.
# Keep comments on their own lines: a value can't share its line with a comment.


# =============================================================================
# REQUIRED: LLM gateway (Task 3: python -m task3_pii_guardrail,
#                        Tasks 3 + 4: python -m task4_model_router)
# =============================================================================

# Primary provider (Anthropic).
ANTHROPIC_API_KEY=

# Backup provider (OpenAI). Needed by Task 4 only.
OPENAI_API_KEY=

# API keys your clients send as "Authorization: Bearer <key>". A JSON list in
# single quotes; each key at least 16 characters, e.g. '["<your key>"]'.
# Left empty on purpose: the gateway refuses to start until you set your own.
# Make a key with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
LLM_GATEWAY_API_KEYS=


# =============================================================================
# REQUIRED: MCP gateway (Task 2: python -m task2_mcp_gateway)
# =============================================================================

# Where allowed MCP traffic goes. Task 1's tools over HTTP:
#   python -m task1_mcp_server.serve_http
GATEWAY_DOWNSTREAM_URL=http://127.0.0.1:8000/mcp

# Tokens must carry exactly this issuer ("iss") and audience ("aud").
# The values below match the dev token tool's defaults.
GATEWAY_JWT_ISSUER=https://idp.dev.local/
GATEWAY_JWT_AUDIENCE=quilr-mcp-gateway

# Public key that verifies tokens. Create a key pair (private key stays in var/,
# which is git-ignored) with:
#   uv run python -m task2_mcp_gateway.devtokens keygen --dir var/keys
# Set this or GATEWAY_JWKS_FILE, not both.
GATEWAY_JWT_PUBLIC_KEY_FILE=var/keys/public.pem


# =============================================================================
# OPTIONAL: uncomment to change. Each line shows the default.
# =============================================================================

# --- Logging and identity (every service) -----------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL (audit events ignore the level)
# LOG_LEVEL=INFO
# json | console
# LOG_FORMAT=json
# stderr | stdout (stdout is refused by the stdio MCP server: it carries JSON-RPC)
# LOG_STREAM=stderr
# Tamper-evident audit trail file (off by default), its HMAC key (>= 32 chars,
# recommended whenever the file is on), and whether each record is fsynced.
# LOG_AUDIT_PATH=var/audit/audit.jsonl
# LOG_AUDIT_HMAC_KEY=
# LOG_AUDIT_FSYNC=true
# Longest string kept per log field.
# LOG_MAX_FIELD_CHARS=8192
# Stamped on every log line.
# APP_ENV=dev

# --- Task 1: MCP server over HTTP (python -m task1_mcp_server.serve_http) ----
# The stdio server (python -m task1_mcp_server) uses only LOG_* and APP_ENV.
# MCP_SERVER_HOST=127.0.0.1
# MCP_SERVER_PORT=8000

# --- Task 2: MCP gateway ------------------------------------------------------
# GATEWAY_JWKS_FILE=var/keys/jwks.json
# GATEWAY_JWT_ALGORITHMS=["RS256","ES256"]
# GATEWAY_JWT_LEEWAY_S=30
# GATEWAY_MAX_BODY_BYTES=1048576
# GATEWAY_CONNECT_TIMEOUT_S=5
# GATEWAY_REQUEST_TIMEOUT_S=60
# GATEWAY_STREAM_TIMEOUT_S=300
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=8080

# --- Task 3: LLM gateway (also used by Task 4) -------------------------------
# LLM_GATEWAY_MODEL=claude-opus-5-5
# LLM_GATEWAY_DEFAULT_MAX_TOKENS=4096
# Offline runs: the mock Anthropic API (python -m task3_pii_guardrail.mock_provider --port 9090)
# LLM_GATEWAY_ANTHROPIC_BASE_URL=http://127.0.0.1:9090
# LLM_GATEWAY_REFUSAL_FALLBACK=true
# LLM_GATEWAY_PROVIDER_TIMEOUT_S=120
# Task 3 alone. Task 4 always uses 0 for the primary, so a 429 fails over at once.
# LLM_GATEWAY_PROVIDER_MAX_RETRIES=2
# LLM_GATEWAY_MAX_BODY_BYTES=1048576
# LLM_GATEWAY_HOST=127.0.0.1
# LLM_GATEWAY_PORT=8090

# --- Task 4: rate limiter and failover ---------------------------------------
# Per client API key, over a sliding window of LLM_ROUTER_WINDOW_S seconds.
# LLM_ROUTER_TOKENS_PER_MINUTE=50000
# LLM_ROUTER_WINDOW_S=60
# LLM_ROUTER_DB_PATH=var/ratelimit.sqlite3
# The primary must answer within this, or the backup serves.
# LLM_ROUTER_PRIMARY_TIMEOUT_MS=3000
# LLM_ROUTER_BACKUP_TIMEOUT_S=30
# LLM_ROUTER_BACKUP_MAX_RETRIES=0
# LLM_ROUTER_OPENAI_MODEL=gpt-6.1-sol
# Offline runs: the mock OpenAI API (python -m task4_model_router.mock_openai --port 9092)
# LLM_ROUTER_OPENAI_BASE_URL=http://127.0.0.1:9092/v1
