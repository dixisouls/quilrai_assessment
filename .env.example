# Example configuration. Copy to .env (git-ignored) and adjust. Values are fake.

# --- Logging (all services, quilr_common) -------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL (audit ignores it)
LOG_FORMAT=json                # json | console
LOG_STREAM=stderr              # stderr | stdout (stdout is refused for the stdio MCP server)
# LOG_AUDIT_PATH=var/audit/gateway.jsonl
# LOG_AUDIT_HMAC_KEY=change-me-to-at-least-32-random-characters
APP_ENV=dev

# --- Task 2: MCP security gateway ---------------------------------------------
GATEWAY_DOWNSTREAM_URL=http://127.0.0.1:9000/mcp
GATEWAY_JWT_ISSUER=https://idp.dev.local/
GATEWAY_JWT_AUDIENCE=quilr-mcp-gateway
GATEWAY_JWT_PUBLIC_KEY_FILE=var/keys/public.pem   # or GATEWAY_JWKS_FILE=var/keys/jwks.json
# GATEWAY_JWT_ALGORITHMS=["RS256","ES256"]
# GATEWAY_JWT_LEEWAY_S=30
# GATEWAY_MAX_BODY_BYTES=1048576
# GATEWAY_CONNECT_TIMEOUT_S=5
# GATEWAY_REQUEST_TIMEOUT_S=60
# GATEWAY_STREAM_TIMEOUT_S=300
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
