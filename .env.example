# Example configuration. Copy to .env (git-ignored) and adjust. Values are fake.

# --- Logging (all services, quilr_common) -------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL (audit ignores it)
LOG_FORMAT=json                # json | console
LOG_STREAM=stderr              # stderr | stdout (stdout is refused for the stdio MCP server)
# LOG_AUDIT_PATH=var/audit/gateway.jsonl
# LOG_AUDIT_HMAC_KEY=change-me-to-at-least-32-random-characters
APP_ENV=dev

# --- Task 2: MCP security gateway ---------------------------------------------
GATEWAY_DOWNSTREAM_URL=http://127.0.0.1:9000/mcp
GATEWAY_JWT_ISSUER=https://idp.dev.local/
GATEWAY_JWT_AUDIENCE=quilr-mcp-gateway
GATEWAY_JWT_PUBLIC_KEY_FILE=var/keys/public.pem   # or GATEWAY_JWKS_FILE=var/keys/jwks.json
# GATEWAY_JWT_ALGORITHMS=["RS256","ES256"]
# GATEWAY_JWT_LEEWAY_S=30
# GATEWAY_MAX_BODY_BYTES=1048576
# GATEWAY_CONNECT_TIMEOUT_S=5
# GATEWAY_REQUEST_TIMEOUT_S=60
# GATEWAY_STREAM_TIMEOUT_S=300
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# --- Task 3: LLM gateway (streaming PII guardrail) -----------------------------
# ANTHROPIC_API_KEY=sk-ant-...            # read by the Anthropic SDK; never put a real key here
# Single-quoted so the JSON survives `set -a; source .env`. Each key >= 16 chars.
LLM_GATEWAY_API_KEYS='["change-me-client-key-1"]'
LLM_GATEWAY_MODEL=claude-opus-5-5
# LLM_GATEWAY_DEFAULT_MAX_TOKENS=4096
# LLM_GATEWAY_ANTHROPIC_BASE_URL=http://127.0.0.1:9090   # mock provider for offline runs
# LLM_GATEWAY_REFUSAL_FALLBACK=true
# LLM_GATEWAY_PROVIDER_TIMEOUT_S=120
# LLM_GATEWAY_PROVIDER_MAX_RETRIES=2
# LLM_GATEWAY_MAX_BODY_BYTES=1048576
LLM_GATEWAY_HOST=127.0.0.1
LLM_GATEWAY_PORT=8090

# --- Task 4: rate limiter and model failover (run: python -m task4_model_router) ---
# OPENAI_API_KEY=sk-...                    # read by the OpenAI SDK; never put a real key here
# LLM_ROUTER_TOKENS_PER_MINUTE=50000       # per tenant API key, sliding 60 s window
# LLM_ROUTER_WINDOW_S=60
# LLM_ROUTER_DB_PATH=var/ratelimit.sqlite3
# LLM_ROUTER_PRIMARY_TIMEOUT_MS=3000       # primary must answer within this, or the backup serves
# LLM_ROUTER_BACKUP_TIMEOUT_S=30
# LLM_ROUTER_BACKUP_MAX_RETRIES=0
# LLM_ROUTER_OPENAI_MODEL=gpt-6.1-sol
# LLM_ROUTER_OPENAI_BASE_URL=http://127.0.0.1:9092/v1   # mock OpenAI for offline runs
